[Unit]
Description=Office Parking Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and WorkingDirectory to your server:
User=ubuntu
WorkingDirectory=/opt/parking-bot
EnvironmentFile=/opt/parking-bot/.env
ExecStart=/opt/parking-bot/.venv/bin/python /opt/parking-bot/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
