# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-me-with-your-token

# Telegram numeric ID of the first admin. Get it from @userinfobot.
# Leave empty to make the FIRST person who registers the admin.
ADMIN_TELEGRAM_ID=

# Where the SQLite database file lives
DB_PATH=parking.db

# Optional: restrict bot to a single office chat (leave empty to allow anywhere)
# ALLOWED_CHAT_ID=

# Last day the rotating-spot schedule is valid (YYYY-MM-DD). Spot owners can
# only pick days up to this date in the calendar. Leave empty for no limit.
ROTATION_END=2026-12-31